# Configuration de développement : copier ce fichier vers .env, puis renseigner les valeurs vides.
# Les sections vont de la plus importante à la plus technique.

# --- Application -------------------------------------------------------------------------------------

# Clef de chiffrement des cookies, générée par « php artisan key:generate ». La changer déconnecte
# tous les utilisateurs.
APP_KEY=
APP_NAME=Portfolios
# local en développement ; APP_DEBUG affiche le détail des erreurs, avec leur trace.
APP_ENV=local
APP_DEBUG=true
# Adresse de l'application, reprise dans les liens générés (mails…). Les navigateurs résolvent
# *.localhost vers 127.0.0.1. « php artisan serve » écoute sur SERVER_PORT, que APP_URL doit reprendre,
# avec PHP_CLI_SERVER_WORKERS processus pour servir plusieurs requêtes à la fois.
APP_URL=http://portfolios.localhost:10000
SERVER_PORT=10000
PHP_CLI_SERVER_WORKERS=4

# --- Administrateur ----------------------------------------------------------------------------------

# Compte créé par « php artisan migrate --seed » (id 1). Les quatre variables sont obligatoires, sans
# valeur par défaut : le seed s'arrête sur une valeur absente ou invalide (mot de passe de 8 caractères
# au moins). APP_ADMIN_EMAIL reçoit aussi les mails de création et d'archivage des portfolios.
APP_ADMIN_LAST_NAME=
APP_ADMIN_FIRST_NAME=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Base de données ---------------------------------------------------------------------------------

# MySQL 8.0 ou plus récent. Les tests utilisent les mêmes accès, sur la base portfolios_test fixée
# par phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolios_dev
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# --- Mail --------------------------------------------------------------------------------------------

# Réinitialisation du mot de passe, vérification de l'adresse et mails à l'administrateur.
# MAIL_MAILER=log écrit les mails dans le journal sans les envoyer. Avec MAIL_SCHEME=null, le
# chiffrement se déduit du port : TLS direct sur 465, STARTTLS sinon.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Langue et fuseau horaire ------------------------------------------------------------------------

# APP_FAKER_LOCALE règle la langue des données factices des factories.
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# --- Session -----------------------------------------------------------------------------------------

# Sessions rangées en base, dans la table sessions. SESSION_LIFETIME est en minutes ;
# SESSION_EXPIRE_ON_CLOSE termine la session à la fermeture du navigateur.
SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions
SESSION_LIFETIME=360
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- File, cache et maintenance ----------------------------------------------------------------------

# Les mails passent par la file database : un worker doit tourner (« composer dev » le lance).
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_CONNECTION=mysql
DB_CACHE_LOCK_CONNECTION=mysql
# Mode maintenance (« php artisan down ») : noté dans un fichier (file), ou dans le cache (cache, avec
# le store APP_MAINTENANCE_STORE) pour le partager entre plusieurs serveurs.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# --- Journaux ----------------------------------------------------------------------------------------

# Un seul fichier, storage/logs/laravel.log. LOG_LEVEL fixe le niveau minimal écrit (debug, info,
# warning, error…) ; les avertissements de dépréciation ne sont pas journalisés.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Divers ------------------------------------------------------------------------------------------

# Coût du hachage des mots de passe (bcrypt), et disque de stockage par défaut (storage/app/private).
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local

# Disque privé des photos de profil : local sur un serveur, celui du bucket privé sur Laravel Cloud.
AVATAR_DISK=local

# --- Laravel Cloud -----------------------------------------------------------------------------------

# Deploy hook de l'environnement Laravel Cloud, lu par bin/deploy-laravel-cloud.sh, jamais par
# l'application. Secret : cette adresse suffit à lancer un déploiement.
LARAVEL_CLOUD_DEPLOY_HOOK=
