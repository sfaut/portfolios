# Run "$ php artisan key:generate"
APP_KEY=

APP_NAME=Portfolios
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
# Browsers resolve *.localhost to 127.0.0.1; "php artisan serve" listens on SERVER_PORT
APP_URL=http://portfolios.localhost:10000
SERVER_PORT=10000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# App admin
# $ php artisan migrate --seed
# APP_ADMIN_EMAIL also receives the portfolio mails, which are not sent without it
# APP_ADMIN_LAST_NAME=
# APP_ADMIN_FIRST_NAME=
# APP_ADMIN_EMAIL=
# APP_ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolios_dev
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_USERNAME=
DB_PASSWORD=

DB_CACHE_CONNECTION=mysql
DB_CACHE_LOCK_CONNECTION=mysql
DB_QUEUE_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions
SESSION_LIFETIME=360
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=


MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

